# Copy this file to `.env` (same folder as manage.py) and fill in your values.
# `.env` is git-ignored. On a host such as Render, set these in its dashboard instead.

# Local development: leave DJANGO_DEBUG=1. In production set it to 0.
DJANGO_DEBUG=1

# Required when DJANGO_DEBUG=0. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated hosts for production, e.g. anitha-portfolio.onrender.com
DJANGO_ALLOWED_HOSTS=*
# Needed for the contact form on https sites, e.g. https://anitha-portfolio.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Public URL of the site (used for the "View My Projects" link in the thank-you email)
SITE_URL=https://anitha-portfolio.onrender.com

# Contact form email (Gmail). Use a Gmail *App Password*, never your normal password.
# If EMAIL_HOST_PASSWORD is empty, emails are printed in the terminal instead of being sent.
EMAIL_HOST_USER=ntanithasaravanan@gmail.com
EMAIL_HOST_PASSWORD=
